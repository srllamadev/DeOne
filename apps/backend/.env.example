PORT=4000
HOST=127.0.0.1
# simulated funciona sin credenciales. testnet usa BOBT/COPT propios en Stellar Testnet.
STELLAR_MODE=simulated
# Testnet: ejecutar `npm run setup:assets -w @deone/backend` crea estas llaves en .env (no commitear).
WALLET_USER1_SECRET=
WALLET_USER2_SECRET=
STELLAR_ASSET_ISSUER_SECRET=
STELLAR_TREASURY_SECRET=
# success o failed. Solo afecta al desembolso simulado.
DEMO_PAYOUT_RESULT=success
